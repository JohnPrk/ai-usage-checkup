{
  "name": "ai-usage-checkup",
  "productName": "AI 성적표",
  "version": "0.5.0",
  "description": "Claude Code 사용 패턴 분석 + opus 코칭 데스크탑 앱",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && cp src/renderer/index.html src/renderer/style.css dist/renderer/",
    "start": "npm run build && electron .",
    "cli": "node dist/core/cli.js",
    "predist": "node scripts/ensure-nfd.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "node scripts/ensure-nfd.mjs && npm run build && electron-builder --mac --arm64",
    "dist:win": "node scripts/ensure-nfd.mjs && npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.tnew.ai-usage-checkup",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3"
  }
}
