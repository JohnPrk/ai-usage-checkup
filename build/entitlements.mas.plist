<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Store(MAS) 필수: 앱 샌드박스. 이게 켜져야 스토어 심사를 통과한다. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <!-- Supabase 익명 랭킹 전송(outgoing). 서버를 여는 건 아니라 network.server 는 불필요. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- 사용자가 폴더 선택창에서 직접 고른 폴더(~/.claude)만 읽는다. 앱은 그 폴더에
       쓰지 않고 userData(컨테이너 안)에만 쓰므로 read-only 로 충분하다.
       이 권한 + security-scoped bookmark 조합으로 재실행 때도 접근이 유지된다. -->
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
