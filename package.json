{
  "name": "ai-usage-checkup",
  "productName": "AI 리포트",
  "version": "0.9.5",
  "description": "Claude Code 사용 패턴 분석 + opus 코칭 데스크탑 앱",
  "license": "MIT",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && cp src/renderer/index.html src/renderer/style.css dist/renderer/ && mkdir -p dist/renderer/emblems && cp src/renderer/emblems/*.png dist/renderer/emblems/",
    "start": "npm run build && electron .",
    "cli": "node dist/core/cli.js",
    "predist": "node scripts/ensure-nfd.mjs",
    "dist": "npm run build && electron-builder",
    "dist:mac": "node scripts/ensure-nfd.mjs && npm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "node scripts/ensure-nfd.mjs && npm run build && electron-builder --win --x64",
    "dist:mas-store": "node scripts/ensure-nfd.mjs && npm run build && electron-builder --mac mas --arm64",
    "docs": "python3 -m http.server 4178 --directory docs"
  },
  "build": {
    "appId": "com.tinho.ai-usage-checkup",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "AI.Usage.Checkup-${version}-${arch}.${ext}",
      "extendInfo": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "mas": {
      "type": "distribution",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "hardenedRuntime": false
    },
    "dmg": {
      "artifactName": "AI.Usage.Checkup-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "AI.Usage.Checkup-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.2",
    "typescript": "^6.0.3"
  }
}
